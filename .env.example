# Backend: "hf" (HuggingFace Inference Providers) o "local" (servidor OpenAI-compatible: vLLM / Ollama / TGI)
LLM_BACKEND=hf
HERMES_MODEL=NousResearch/Hermes-3-Llama-3.1-8B

# backend hf
HUGGINGFACEHUB_API_TOKEN=hf_xxx

# backend local (ej. vLLM: --enable-auto-tool-choice --tool-call-parser hermes)
LOCAL_BASE_URL=http://localhost:8000/v1
LOCAL_API_KEY=not-needed
